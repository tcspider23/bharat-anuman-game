# ===== AI MODEL API KEYS =====
# Add ONE of these keys to enable the AI model features.
# Bharat Anuman uses an LLM for natural language interactions (dialogue, hints, reasoning).
# The core probability engine works without these keys (fallback mode).

# RECOMMENDED: Groq (FREE, FAST) — Llama 3.3 / Mixtral
# Get key: https://console.groq.com/
GROQ_API_KEY=

# Alternative: Google Gemini (FREE tier) — Gemini 1.5 Flash / Pro
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternative: OpenAI — GPT-4o-mini / GPT-4o (PAID)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which model to use: "groq" | "gemini" | "openai"
# Default: groq (fastest, free)
AI_MODEL=groq
